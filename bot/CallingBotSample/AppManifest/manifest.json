{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "version": "1.0.4",
  "manifestVersion": "1.19",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "syncLingo",
    "websiteUrl": "https://sync.example.com",
    "privacyUrl": "https://sync.example.com/privacy",
    "termsOfUseUrl": "https://sync.example.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "meeting bot",
    "full": "meeting bot"
  },
  "description": {
    "short": "Meeting bot for interpretation and summary delivery",
    "full": "syncLingo meeting bot for simultaneous interpretation and summary delivery"
  },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "commandLists": [
        {
          "commands": [
            {
              "title": "welcome",
              "description": "Show welcome message"
            }
          ],
          "scopes": [
            "personal"
          ]
        }
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "sync.example.com"
  ],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://sync.example.com/00000000-0000-0000-0000-000000000000"
  }
}
