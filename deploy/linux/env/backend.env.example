SPRING_PROFILES_ACTIVE=prod
APP_HOST=0.0.0.0
APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=si_backend
DB_USERNAME=sync_lingo
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://sync.example.com

ADMIN_API_SECRET=REPLACE_WITH_RANDOM_ADMIN_SECRET
INTERNAL_OPS_API_SECRET=REPLACE_WITH_RANDOM_INTERNAL_SECRET
TEAMS_BOT_API_SECRET=REPLACE_WITH_SHARED_BOT_SECRET
SERVICE_SIGNATURE_DOWNSTREAM_KEY=REPLACE_WITH_RANDOM_JAVA_TO_BOT_KEY
SERVICE_SIGNATURE_UPSTREAM_KEY=REPLACE_WITH_RANDOM_BOT_TO_JAVA_KEY
SERVICE_SIGNATURE_UPSTREAM_REQUIRED=true

AZURE_SPEECH_KEY=REPLACE_WITH_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=southeastasia
AZURE_ASR_LANGUAGES=zh-CN,id-ID,en-US
AZURE_ASR_MIN_SENTENCE_EMIT_ID_CHARS=48
AZURE_ASR_MAX_SEGMENT_WORDS=25
AZURE_ASR_FORCE_SEGMENT_MS=6000

GOOGLE_TRANSLATE_API_KEY=REPLACE_WITH_GOOGLE_TRANSLATE_KEY

OPENAI_API_KEY=REPLACE_WITH_OPENAI_OR_OPENROUTER_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPRESSION_MIN_TEXT_LENGTH=40
OPENAI_COMPRESSION_MODEL=anthropic/claude-haiku-4.5
OPENAI_SUMMARY_MODEL=deepseek/deepseek-v4-pro
OPENAI_EXTRACTION_MODEL=anthropic/claude-haiku-4.5
OPENAI_EXTRACTION_DISABLE_REASONING=true
OPENAI_DOCUMENT_SUMMARY_MODEL=deepseek/deepseek-v4-pro
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

CARTESIA_API_KEY=REPLACE_WITH_CARTESIA_KEY
# TTS 一律使用各目标语言的母语男声（已移除性别检测/女声）。
# 全局兜底男声（未配置语种专属男声时使用）
CARTESIA_GLOBAL_MALE_VOICE_ID=REPLACE_WITH_GLOBAL_MALE_VOICE_ID
# 语种专属男声（强烈建议中文配中文母语男声，否则中文 TTS 发音不自然）；留空则回退全局男声。
CARTESIA_ZH_MALE_VOICE_ID=
CARTESIA_EN_MALE_VOICE_ID=
CARTESIA_ID_MALE_VOICE_ID=
CARTESIA_MAX_BUFFER_DELAY_MS=150
CARTESIA_TTS_UNSYNTHESIZED_SKIP_WAIT_MS=12000

SPEAKER_SERVICE_ENABLED=true
SPEAKER_SERVICE_URL=http://127.0.0.1:7000

BOT_API_URL=http://127.0.0.1:3978
BOT_API_ALLOWED_USER_IDS=REPLACE_WITH_COMMA_SEPARATED_OPERATOR_USER_IDS

JAVA_OPTS=-Xms512m -Xmx3g

# 业务日志级别。排查问题时设为 DEBUG 获取最细粒度后端日志
# （含语音性别请求体、判定原因），排查完成后改回 INFO。
SI_LOG_LEVEL=INFO
