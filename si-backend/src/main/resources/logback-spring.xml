<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- 所有日志写到 System.err，Docker 容器里 stderr 是行缓冲，立即可见 -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>

  <logger name="com.si.backend" level="INFO" additivity="false">
    <appender-ref ref="STDERR"/>
  </logger>

  <logger name="com.microsoft.cognitiveservices.speech" level="INFO" additivity="false">
    <appender-ref ref="STDERR"/>
  </logger>

  <logger name="com.si.backend.integration" level="DEBUG" additivity="false">
    <appender-ref ref="STDERR"/>
  </logger>
</configuration>
