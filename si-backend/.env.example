# Application
APP_PORT=8080
APP_HOST=0.0.0.0
SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=si_backend
DB_USERNAME=root
DB_PASSWORD=

# Azure AI Speech (ASR + TTS)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Azure AI Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus

# Cartesia (Voice Clone TTS)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_API_URL=wss://api.cartesia.ai

# VoiceMeeter (Virtual Audio Device Passthrough)
VOICEMEETER_ENABLED=false
VOICEMEETER_SOURCE_CHANNEL=1
VOICEMEETER_TARGET_CHANNEL=2

# JWT
JWT_SECRET=change_this_secret_to_random_32_plus_chars
JWT_EXPIRATION_MS=86400000

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
