# Application
APP_PORT=8080
APP_HOST=0.0.0.0
SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=si_backend
DB_USERNAME=root
DB_PASSWORD=

# Azure AI Speech (ASR + TTS)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_ASR_LANGUAGES=zh-CN,id-ID,en-US
AZURE_ASR_END_SILENCE_TIMEOUT_MS=1500

# Self-hosted Speaker Recognition (SpeechBrain ECAPA-TDNN microservice — required for voiceprint features)
# Start with: cd speaker-service && ./start.sh (or start.bat on Windows)
SPEAKER_SERVICE_ENABLED=false
SPEAKER_SERVICE_URL=http://localhost:7000
SPEAKER_SERVICE_MIN_SCORE=0.4
# Higher cosine score required to SWITCH away from the current resolved speaker
# (anti-flicker hysteresis); low-confidence differing readings are ignored.
SPEAKER_SERVICE_SWITCH_SCORE=0.45
# Min gap between best and runner-up candidate to trust a switch (Top-2 margin);
# closer than this = ambiguous (similar voices) → keep current speaker.
SPEAKER_SERVICE_MARGIN_THRESHOLD=0.06

# Azure AI Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus

# Google Translate
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
GOOGLE_TRANSLATE_GLOSSARY_ENABLED=false
GOOGLE_TRANSLATE_PROJECT_ID=your_google_cloud_project_id
GOOGLE_TRANSLATE_LOCATION=us-central1
GOOGLE_TRANSLATE_GLOSSARY_ID=your_google_translate_glossary_id
GOOGLE_TRANSLATE_GLOSSARY_ZH_TO_ID_ID=
GOOGLE_TRANSLATE_GLOSSARY_ID_TO_ZH_ID=
GOOGLE_TRANSLATE_GLOSSARY_ZH_TO_EN_ID=
GOOGLE_TRANSLATE_GLOSSARY_EN_TO_ZH_ID=
GOOGLE_TRANSLATE_GLOSSARY_ID_TO_EN_ID=
GOOGLE_TRANSLATE_GLOSSARY_EN_TO_ID_ID=
GOOGLE_TRANSLATE_GLOSSARY_IGNORE_CASE=true
GOOGLE_TRANSLATE_GLOSSARY_FALLBACK_ENABLED=true

# Chat LLM (compression + meeting/file summaries). OpenAI-compatible — works with
# OpenAI, OpenRouter (https://openrouter.ai/api/v1), etc.
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REFERER=http://localhost:5173
OPENAI_TITLE=syncLingo-plus
OPENAI_COMPRESSION_ENABLED=true
OPENAI_COMPRESSION_MIN_TEXT_LENGTH=40
# Use a model ID valid for your provider, e.g. gpt-4o-mini, or anthropic/claude-3.5-sonnet on OpenRouter.
OPENAI_COMPRESSION_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_SUMMARY_MODEL=gpt-4o
OPENAI_COMPRESSION_MAX_OUTPUT_TOKENS=512
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=1200
OPENAI_DOCUMENT_SUMMARY_MAX_OUTPUT_TOKENS=4000
# Semantic search / RAG embeddings.
# Optional separate embedding endpoint (blank = reuse OPENAI_BASE_URL / OPENAI_API_KEY above).
# OpenRouter serves embeddings too, so chat + embeddings can share one key/base; on OpenRouter
# use a namespaced model id, e.g. openai/text-embedding-3-small.
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_TOP_K=20
OPENAI_EMBEDDING_MIN_SCORE=0.3

# Cartesia (Voice Clone TTS)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_API_URL=wss://api.cartesia.ai
CARTESIA_DEFAULT_VOICE_ID_ZH=6eb8965c-e295-47bd-a9e4-3eeebb3abcff
CARTESIA_DEFAULT_VOICE_ID_ID=a053f6bc-7df4-40de-96d4-de026bc47ce8
CARTESIA_DEFAULT_VOICE_ID_EN=default
# Voice-clone denoise: false = highest similarity on clean samples; true = denoise first
# (better for noisy live-meeting audio).
CARTESIA_CLONE_ENHANCE=false

# JWT
JWT_SECRET=change_this_secret_to_random_32_plus_chars
JWT_EXPIRATION_MS=86400000

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
